{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App self-test result document",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "schema_version": {"type": "string"},
    "execution_mode": {"enum": ["full", "sample", "intermediate"]},
    "execution_manifest": {"$ref": "#/$defs/executionManifest"},
    "setup_trace": {"type": "array"},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "file": {"type": "string"},
              "description": {"type": "string"},
              "text": {"type": "string"},
              "label": {"type": "string"}
            }
          }
        ]
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "executionManifest": {
      "type": "object",
      "required": ["expected_count"],
      "properties": {
        "mode": {"enum": ["full", "sample"]},
        "expected_count": {"type": "integer", "minimum": 0},
        "selected_cases": {"type": "array"},
        "selected": {"type": "array"},
        "selected_case_refs": {"type": "array"},
        "selected_case_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["step_id", "step_index", "status", "actual"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "step_index": {"type": "integer", "minimum": 1},
        "row": {"type": "integer", "minimum": 1},
        "source_row": {"type": "integer", "minimum": 1},
        "action": {"type": "string"},
        "expected": {"type": "string"},
        "observation": {"type": "string"},
        "action_trace": {"$ref": "#/$defs/trace"},
        "execution_trace": {"$ref": "#/$defs/trace"},
        "attempt_trace": {"$ref": "#/$defs/trace"},
        "blocked_reason": {"type": "string"},
        "blocker": {"type": "string"},
        "reason": {"type": "string"},
        "status": {"type": "string", "minLength": 1},
        "actual": {"type": "string"},
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "tested_at": {"type": "string"},
        "execution_order": {"type": "integer", "minimum": 1}
      },
      "anyOf": [
        {"required": ["row"]},
        {"required": ["source_row"]}
      ]
    },
    "case": {
      "type": "object",
      "required": ["sheet", "row", "status"],
      "properties": {
        "sheet": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 1},
        "source_row": {"type": "integer", "minimum": 1},
        "case_id": {"type": "string"},
        "case_name": {"type": "string"},
        "tc_id": {"type": "string"},
        "source_order": {"type": "integer", "minimum": 1},
        "execution_order": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "observation": {"type": "string"},
        "action_trace": {"$ref": "#/$defs/trace"},
        "execution_trace": {"$ref": "#/$defs/trace"},
        "attempt_trace": {"$ref": "#/$defs/trace"},
        "blocked_reason": {"type": "string"},
        "blocker": {"type": "string"},
        "skip_reason": {"type": "string"},
        "not_executed_reason": {"type": "string"},
        "reason": {"type": "string"},
        "actual": {"type": "string"},
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"}
        },
        "tier": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "tested_at": {"type": "string"}
      },
      "anyOf": [
        {"required": ["actual"]},
        {"required": ["steps"]}
      ]
    }
  }
}
